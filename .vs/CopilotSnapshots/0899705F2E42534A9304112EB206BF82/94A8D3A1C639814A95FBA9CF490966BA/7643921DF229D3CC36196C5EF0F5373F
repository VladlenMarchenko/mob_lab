using System;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Media;
using System.Windows.Media.Imaging;

namespace PixelArtEditor;

public enum DrawingTool
{
    Pixel,
    Line,
    Square,
    Triangle
}

public partial class MainWindow : Window
{
    private const int CanvasSize = 32;
    private const int CellSize = 16;

    private readonly Color[,] _pixels = new Color[CanvasSize, CanvasSize];
    private Color[,]? _previewPixels;
    private DrawingTool _currentTool = DrawingTool.Pixel;
    private Color _currentColor = Colors.Black;
    private Point? _startPoint;

    public MainWindow()
    {
        InitializeComponent();
        ClearPixels();
        RenderCanvas(_pixels);
    }

    private void Tool_Checked(object sender, RoutedEventArgs e)
    {
        if (sender is RadioButton radioButton &&
            Enum.TryParse(radioButton.Tag?.ToString(), out DrawingTool selectedTool))
        {
            _currentTool = selectedTool;
        }
    }

    private void ColorSelector_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ColorSelector.SelectedItem is ComboBoxItem item && item.Tag is string hex)
        {
            _currentColor = (Color)ColorConverter.ConvertFromString(hex);
            ColorPreview.Background = new SolidColorBrush(_currentColor);
        }
    }

    private void Clear_Click(object sender, RoutedEventArgs e)
    {
        ClearPixels();
        RenderCanvas(_pixels);
    }

    private void Fill_Click(object sender, RoutedEventArgs e)
    {
        for (int x = 0; x < CanvasSize; x++)
        {
            for (int y = 0; y < CanvasSize; y++)
            {
                _pixels[x, y] = _currentColor;
            }
        }

        RenderCanvas(_pixels);
    }

    private void ClearPixels()
    {
        for (int x = 0; x < CanvasSize; x++)
        {
            for (int y = 0; y < CanvasSize; y++)
            {
                _pixels[x, y] = Colors.White;
            }
        }
    }

    private void PixelCanvas_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
    {
        Point pixel = GetPixelPosition(e.GetPosition(PixelCanvas));
        _startPoint = pixel;
        PixelCanvas.CaptureMouse();

        if (_currentTool == DrawingTool.Pixel)
        {
            SetPixel(_pixels, pixel, _currentColor);
            RenderCanvas(_pixels);
        }
        else
        {
            _previewPixels = ClonePixels(_pixels);
            DrawTool(_previewPixels, pixel);
            RenderCanvas(_previewPixels);
        }
    }

    private void PixelCanvas_MouseMove(object sender, MouseEventArgs e)
    {
        if (_startPoint is null || e.LeftButton != MouseButtonState.Pressed)
        {
            return;
        }

        Point pixel = GetPixelPosition(e.GetPosition(PixelCanvas));

        if (_currentTool == DrawingTool.Pixel)
        {
            SetPixel(_pixels, pixel, _currentColor);
            RenderCanvas(_pixels);
            return;
        }

        _previewPixels = ClonePixels(_pixels);
        DrawTool(_previewPixels, pixel);
        RenderCanvas(_previewPixels);
    }

    private void PixelCanvas_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)
    {
        if (_startPoint is null)
        {
            return;
        }

        if (_currentTool != DrawingTool.Pixel && _previewPixels is not null)
        {
            CopyPixels(_previewPixels, _pixels);
        }

        _previewPixels = null;
        _startPoint = null;
        PixelCanvas.ReleaseMouseCapture();
        RenderCanvas(_pixels);
    }

    private void DrawTool(Color[,] target, Point endPoint)
    {
        if (_startPoint is null)
        {
            return;
        }

        int x1 = (int)_startPoint.Value.X;
        int y1 = (int)_startPoint.Value.Y;
        int x2 = (int)endPoint.X;
        int y2 = (int)endPoint.Y;

        switch (_currentTool)
        {
            case DrawingTool.Line:
                DrawLine(target, x1, y1, x2, y2);
                break;
            case DrawingTool.Square:
                DrawSquare(target, x1, y1, x2, y2);
                break;
            case DrawingTool.Triangle:
                DrawTriangle(target, x1, y1, x2, y2);
                break;
        }
    }

    private void DrawLine(Color[,] target, int x1, int y1, int x2, int y2)
    {
        int dx = Math.Abs(x2 - x1);
        int sx = x1 < x2 ? 1 : -1;
        int dy = -Math.Abs(y2 - y1);
        int sy = y1 < y2 ? 1 : -1;
        int error = dx + dy;

        while (true)
        {
            SetPixel(target, new Point(x1, y1), _currentColor);
            if (x1 == x2 && y1 == y2)
            {
                break;
            }

            int doubleError = 2 * error;
            if (doubleError >= dy)
            {
                error += dy;
                x1 += sx;
            }
            if (doubleError <= dx)
            {
                error += dx;
                y1 += sy;
            }
        }
    }

    private void DrawSquare(Color[,] target, int x1, int y1, int x2, int y2)
    {
        int left = Math.Min(x1, x2);
        int right = Math.Max(x1, x2);
        int top = Math.Min(y1, y2);
        int bottom = Math.Max(y1, y2);

        DrawLine(target, left, top, right, top);
        DrawLine(target, right, top, right, bottom);
        DrawLine(target, right, bottom, left, bottom);
        DrawLine(target, left, bottom, left, top);
    }

    private void DrawTriangle(Color[,] target, int x1, int y1, int x2, int y2)
    {
        int left = Math.Min(x1, x2);
        int right = Math.Max(x1, x2);
        int top = Math.Min(y1, y2);
        int bottom = Math.Max(y1, y2);
        int center = (left + right) / 2;

        DrawLine(target, center, top, left, bottom);
        DrawLine(target, left, bottom, right, bottom);
        DrawLine(target, right, bottom, center, top);
    }

    private static void SetPixel(Color[,] target, Point point, Color color)
    {
        int x = (int)point.X;
        int y = (int)point.Y;
        if (x >= 0 && x < CanvasSize && y >= 0 && y < CanvasSize)
        {
            target[x, y] = color;
        }
    }

    private static Point GetPixelPosition(Point position)
    {
        int x = Math.Clamp((int)(position.X / CellSize), 0, CanvasSize - 1);
        int y = Math.Clamp((int)(position.Y / CellSize), 0, CanvasSize - 1);
        return new Point(x, y);
    }

    private void RenderCanvas(Color[,] source)
    {
        DrawingVisual visual = new DrawingVisual();
        using (DrawingContext context = visual.RenderOpen())
        {
            context.DrawRectangle(Brushes.White, null, new Rect(0, 0, CanvasSize * CellSize, CanvasSize * CellSize));

            for (int x = 0; x < CanvasSize; x++)
            {
                for (int y = 0; y < CanvasSize; y++)
                {
                    SolidColorBrush brush = new SolidColorBrush(source[x, y]);
                    context.DrawRectangle(brush, new Pen(new SolidColorBrush(Color.FromRgb(215, 215, 215)), 1),
                        new Rect(x * CellSize, y * CellSize, CellSize, CellSize));
                }
            }
        }

        RenderTargetBitmap bitmap = new RenderTargetBitmap(CanvasSize * CellSize, CanvasSize * CellSize, 96, 96, PixelFormats.Pbgra32);
        bitmap.Render(visual);
        bitmap.Freeze();
        PixelCanvas.Source = bitmap;
    }

    private static Color[,] ClonePixels(Color[,] source)
    {
        Color[,] copy = new Color[CanvasSize, CanvasSize];
        CopyPixels(source, copy);
        return copy;
    }

    private static void CopyPixels(Color[,] source, Color[,] target)
    {
        for (int x = 0; x < CanvasSize; x++)
        {
            for (int y = 0; y < CanvasSize; y++)
            {
                target[x, y] = source[x, y];
            }
        }
    }
}
