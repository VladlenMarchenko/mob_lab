<Window x:Class="PixelArtEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Art Editor" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#252526">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#333337" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Pixel Art Editor" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,25,0" />
                <Button Content="Очистить" Width="110" Height="32" Click="Clear_Click" Margin="0,0,10,0" />
                <Button Content="Залить холст" Width="110" Height="32" Click="Fill_Click" Margin="0,0,10,0" />
                <Button Content="Сохранить PNG" Width="120" Height="32" Click="SavePng_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="CanvasScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="20" Background="#1E1E1E">
            <Border BorderBrush="#777777" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PixelCanvas" Stretch="None" SnapsToDevicePixels="True"
                       MouseLeftButtonDown="PixelCanvas_MouseLeftButtonDown"
                       MouseMove="PixelCanvas_MouseMove"
                       MouseLeftButtonUp="PixelCanvas_MouseLeftButtonUp"
                       MouseDown="PixelCanvas_MouseDown"
                       MouseUp="PixelCanvas_MouseUp"
                       Cursor="Pen" />
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#3E3E42" Padding="10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Инструмент:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton Content="Пиксель" Tag="Pixel" IsChecked="True" GroupName="Tools" Foreground="White" Margin="0,0,12,0" Checked="Tool_Checked" />
                <RadioButton Content="Прямая" Tag="Line" GroupName="Tools" Foreground="White" Margin="0,0,12,0" Checked="Tool_Checked" />
                <RadioButton Content="Квадрат" Tag="Square" GroupName="Tools" Foreground="White" Margin="0,0,12,0" Checked="Tool_Checked" />
                <RadioButton Content="Треугольник" Tag="Triangle" GroupName="Tools" Foreground="White" Margin="0,0,25,0" Checked="Tool_Checked" />
                <RadioButton Content="Лапка" Tag="Pan" GroupName="Tools" Foreground="White" Margin="0,0,25,0" Checked="Tool_Checked" />
                <TextBlock Text="Размер:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CanvasSizeSelector" Width="100" Height="28" SelectedIndex="2" SelectionChanged="CanvasSizeSelector_SelectionChanged" Margin="0,0,18,0">
                    <ComboBoxItem Content="16 x 16" Tag="16,16" />
                    <ComboBoxItem Content="24 x 24" Tag="24,24" />
                    <ComboBoxItem Content="32 x 32" Tag="32,32" />
                    <ComboBoxItem Content="48 x 48" Tag="48,48" />
                    <ComboBoxItem Content="64 x 64" Tag="64,64" />
                </ComboBox>
                <TextBlock Text="Масштаб:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="ZoomSlider" Width="125" Minimum="0.5" Maximum="4" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged" />
                <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="Цвет:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ColorSelector" Width="135" Height="28" SelectedIndex="0" SelectionChanged="ColorSelector_SelectionChanged">
                    <ComboBoxItem Content="Чёрный" Tag="#FF000000" />
                    <ComboBoxItem Content="Белый" Tag="#FFFFFFFF" />
                    <ComboBoxItem Content="Красный" Tag="#FFE53935" />
                    <ComboBoxItem Content="Зелёный" Tag="#FF43A047" />
                    <ComboBoxItem Content="Синий" Tag="#FF1E88E5" />
                    <ComboBoxItem Content="Жёлтый" Tag="#FFFFC107" />
                    <ComboBoxItem Content="Фиолетовый" Tag="#FF8E24AA" />
                    <ComboBoxItem Content="Оранжевый" Tag="#FFFB8C00" />
                </ComboBox>
                <Border x:Name="ColorPreview" Width="28" Height="28" Background="Black" Margin="8,0,0,0" BorderBrush="White" BorderThickness="1" />
                <TextBlock Text=" 32 x 32 пикселя" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="18,0,0,0" />
            </WrapPanel>
        </Border>

    </Grid>
</Window>
