<Window x:Class="PixelArtEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pixel Art Editor" Height="800" Width="1100"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#333337" Padding="12"><StackPanel Orientation="Horizontal"><TextBlock Text="Pixel Art Editor" Foreground="White" FontSize="22" Margin="0,0,25,0"/><Button Content="Очистить" Width="110" Height="32" Click="Clear_Click" Margin="0,0,10,0"/><Button Content="Залить холст" Width="110" Height="32" Click="Fill_Click"/></StackPanel></Border><Border Grid.Row="1" Background="#3E3E42" Padding="10"><WrapPanel><TextBlock Text="Инструмент:" Foreground="White" Margin="0,0,10,0"/><RadioButton Content="Пиксель" Tag="Pixel" IsChecked="True" GroupName="Tools" Foreground="White" Margin="0,0,12,0" Checked="Tool_Checked"/><RadioButton Content="Прямая" Tag="Line" GroupName="Tools" Foreground="White" Margin="0,0,12,0" Checked="Tool_Checked"/><RadioButton Content="Квадрат" Tag="Square" GroupName="Tools" Foreground="White" Margin="0,0,12,0" Checked="Tool_Checked"/><RadioButton Content="Треугольник" Tag="Triangle" GroupName="Tools" Foreground="White" Margin="0,0,25,0" Checked="Tool_Checked"/><TextBlock Text="Цвет:" Foreground="White" Margin="0,0,8,0"/><ComboBox x:Name="ColorSelector" Width="135" SelectedIndex="0" SelectionChanged="ColorSelector_SelectionChanged"><ComboBoxItem Content="Чёрный" Tag="#FF000000"/><ComboBoxItem Content="Белый" Tag="#FFFFFFFF"/><ComboBoxItem Content="Красный" Tag="#FFE53935"/><ComboBoxItem Content="Зелёный" Tag="#FF43A047"/><ComboBoxItem Content="Синий" Tag="#FF1E88E5"/><ComboBoxItem Content="Жёлтый" Tag="#FFFFC107"/></ComboBox><Border x:Name="ColorPreview" Width="28" Height="28" Background="Black" Margin="8,0,0,0"/></WrapPanel></Border><ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="20" Background="#1E1E1E"><Border BorderBrush="#777777" BorderThickness="2"><Image x:Name="PixelCanvas" Stretch="None" SnapsToDevicePixels="True" MouseLeftButtonDown="PixelCanvas_MouseLeftButtonDown" MouseMove="PixelCanvas_MouseMove" MouseLeftButtonUp="PixelCanvas_MouseLeftButtonUp"/></Border></ScrollViewer></Grid></Window>
