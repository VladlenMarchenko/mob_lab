<Window x:Class="RoadEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Editor" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2D2D30" Padding="10">
            <WrapPanel>
                <Button Content="Сгенерировать дороги" Width="165" Height="30" Click="GenerateMap_Click" Cursor="Hand"/>
                <Button Content="Очистить карту" Width="130" Height="30" Click="ClearMap_Click" Cursor="Hand" Margin="10,0,0,0"/>
                <Button Content="Сохранить PNG" Width="130" Height="30" Click="SavePng_Click" Cursor="Hand" Margin="10,0,0,0"/>
                <TextBlock Text="Размер:" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,8,0"/>
                <ComboBox x:Name="MapSizeSelector" Width="105" Height="30" SelectedIndex="2" SelectionChanged="MapSizeSelector_SelectionChanged">
                    <ComboBoxItem Content="12 x 8" Tag="12,8"/>
                    <ComboBoxItem Content="18 x 12" Tag="18,12"/>
                    <ComboBoxItem Content="26 x 16" Tag="26,16"/>
                    <ComboBoxItem Content="32 x 20" Tag="32,20"/>
                    <ComboBoxItem Content="40 x 24" Tag="40,24"/>
                </ComboBox>
                <TextBlock Text="Масштаб:" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,8,0"/>
                <Slider x:Name="ZoomSlider" Width="130" Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="#3E3E42" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Инструмент (Кисть):" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold"/>

                <RadioButton Content="Трава (Ластик)" Tag="Grass" IsChecked="True" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
                <RadioButton Content="Куст" Tag="GrassWithBush" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
                <RadioButton Content="Дорога ➖" Tag="RoadHorizontal" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
                <RadioButton Content="Дорога 🡓" Tag="RoadVertical" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
                <RadioButton Content="Перекресток ✚" Tag="Intersection" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
                <RadioButton Content="Зебра ➖" Tag="CrosswalkHorizontal" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
                <RadioButton Content="Зебра 🡓" Tag="CrosswalkVertical" Foreground="White" Margin="0,0,10,0" Checked="Tool_Checked"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
            <Image x:Name="MapDisplay" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                   MouseLeftButtonDown="MapDisplay_MouseLeftButtonDown"
                   MouseMove="MapDisplay_MouseMove"
                   Cursor="Pen"/>
        </ScrollViewer>
    </Grid>
</Window>
